# Copy to your host's environment settings (the server reads process environment variables).
PORT=3000
# Use 0.0.0.0 when deploying to a container or cloud host.
HOST=127.0.0.1
# Enables the AI chatbot. Without it the chatbot uses rule-based answers.
ANTHROPIC_API_KEY=
# Optional model override for the chatbot.
CLAUDE_MODEL=claude-opus-5-5
